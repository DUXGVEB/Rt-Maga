# Normalize text line endings to LF across Windows and Linux checkouts so
# compile-time hashes (such as sqlx::migrate! SHA-384 checksums) stay identical.
* text=auto eol=lf

*.sql text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.svelte text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.pro text eol=lf
*.sh text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.ico binary
*.icns binary
*.webp binary
*.jpg binary
*.jpeg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.jar binary
*.keystore binary
*.jks binary
